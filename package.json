{
  "name": "google-tasks-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for the Google Tasks API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-tasks-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
